# Copy to .env and fill in. .env is git-ignored.

# Which search provider "scan" uses by default: duckduckgo | serper
DORK_PROVIDER=duckduckgo

# Serper.dev API key (only needed when DORK_PROVIDER=serper)
SERPER_API_KEY=

# Path to the SQLite database (default: ./dork.db)
DORK_DB=./dork.db

# Seconds to wait between search queries during a scan (politeness / rate limit)
DORK_RATE_DELAY=2.0

# Hours a cached query result stays valid before it is re-fetched
DORK_CACHE_TTL_HOURS=72
